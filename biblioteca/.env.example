# ────────────────────────────────────────────────
# Biblioteca API – Taller 2 – Variables de entorno
# Copiar a .env y completar con valores reales
# NUNCA subir .env al repositorio
# ────────────────────────────────────────────────

# Base de datos principal
DATABASE_URL=postgresql+psycopg://postgres:TU_CLAVE@localhost:5432/biblioteca

# Base de datos exclusiva para pytest
TEST_DATABASE_URL=postgresql+psycopg://postgres:TU_CLAVE@localhost:5432/biblioteca_test

# SECRET_KEY: generar con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=REEMPLAZAR_CON_CLAVE_ALEATORIA_DE_MINIMO_32_CARACTERES

# Algoritmo de firma JWT
ALGORITHM=HS256

# Duración tokens
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Frontends autorizados (lista JSON)
CORS_ORIGINS=["http://localhost:5173"]

# Entorno: dev | test | prod
ENVIRONMENT=dev
